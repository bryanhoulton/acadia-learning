{
  "expo": {
    "name": "Acadia Learning",
    "slug": "mobile",
    "version": "1.0.1",
    "owner": "bryanhoulton",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "acadialearning",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacy": "https://acadialearning.org/privacy",
    "description": "AI-powered homework help and tutoring for students, designed with parents in mind.",
    "primaryColor": "#3B82F6",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["assets/**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acadialearning.mobile",
      "deploymentTarget": "17.5",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Acadia",
        "NSCameraUsageDescription": "This app uses the camera to scan homework problems and for video calls in the classroom.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to help you upload homework problems.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice input when asking questions and for audio calls in the classroom.",
        "UIBackgroundModes": ["audio"],
        "FacebookAdvertiserIDCollectionEnabled": true,
        "FacebookAutoLogAppEventsEnabled": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:acadialearning.org",
        "applinks:www.acadialearning.org"
      ]
    },
    "android": {
      "package": "com.acadialearning.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "MICROPHONE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "acadialearning.org"
            },
            {
              "scheme": "https",
              "host": "www.acadialearning.org"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      ["react-native-localize", { "locales": ["en", "fr"] }],
      [
        "expo-facebook",
        {
          "appID": "1039739124895991",
          "displayName": "Acadia Learning",
          "scheme": "fb1039739124895991",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78d782bd-4191-4803-a810-e2d99fe1b4cd"
      }
    },
    "hooks": {
      "postPublish": []
    }
  }
}
